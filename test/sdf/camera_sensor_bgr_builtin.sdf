<?xml version="1.0"?>
<sdf version="1.6">
  <model name="m1">
    <link name="link1">
      <sensor name="camera_bgr" type="camera">
        <update_rate>10</update_rate>
        <frame_id>base_camera</frame_id>
        <topic>/images_bgr</topic>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>64</width>
            <height>32</height>
            <format>B8G8R8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
