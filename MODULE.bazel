module(
    name = "gz-sensors",
    bazel_compatibility = [">=8.1.0"],
    compatibility_level = 9,
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "buildifier_prebuilt", version = "8.2.1")
bazel_dep(name = "eigen", version = "3.4.0.bcr.3")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_rs", version = "0.0.109")

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2021",
    version = "1.93.0",
)
use_repo(rust_toolchains, "default_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@default_rust_toolchains//...",
    dev_dependency = True,
)

# Gazebo Dependencies
bazel_dep(name = "rules_gazebo", version = "0.0.6")
bazel_dep(name = "gz-common", version = "7.3.0")
bazel_dep(name = "gz-math", version = "9.2.0")
bazel_dep(name = "gz-msgs", version = "12.0.2")
bazel_dep(name = "gz-rendering", version = "10.1.0")
bazel_dep(name = "gz-transport", version = "15.1.0")
bazel_dep(name = "gz-utils", version = "4.0.0.bcr.1")
bazel_dep(name = "sdformat", version = "16.1.0")
